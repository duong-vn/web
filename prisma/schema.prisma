generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model comments {
  comment_id Int         @id(map: "PK__comments__E7957687AC02D544") @default(autoincrement())
  content    String      @db.NVarChar(Max)
  user_id    Int
  post_id    Int
  created_at DateTime?   @default(now(), map: "DF__comments__create__239E4DCF") @db.DateTime
  posts      posts       @relation(fields: [post_id], references: [post_id], onUpdate: NoAction, map: "FK__comments__post_i__25869641")
  users      users       @relation(fields: [user_id], references: [user_id], onUpdate: NoAction, map: "FK__comments__user_i__24927208")
  reactions  reactions[]
}

model group_members {
  group_id  Int
  user_id   Int
  joined_at DateTime? @default(now(), map: "DF__group_mem__joine__1A14E395") @db.DateTime
  groups    groups    @relation(fields: [group_id], references: [group_id], onUpdate: NoAction, map: "FK__group_mem__group__1B0907CE")
  users     users     @relation(fields: [user_id], references: [user_id], onUpdate: NoAction, map: "FK__group_mem__user___1BFD2C07")

  @@id([user_id, group_id])
}

model groups {
  group_id          Int             @id(map: "PK__groups__D57795A04E0C402C") @default(autoincrement())
  group_name        String          @unique @db.NVarChar(255)
  created_by        Int?
  privacy           String?          @db.VarChar(10)
  image             String?         @db.NVarChar(Max)
  description       String?         @db.NVarChar(Max)
  number_of_posts   Int?            @default(1, map: "DF__groups__number_o__145C0A3F")
  number_of_members Int?            @default(1, map: "DF__groups__number_o__15502E78")
  created_at        DateTime?       @default(now(), map: "DF__groups__created___164452B1") @db.DateTime
  group_members     group_members[]
  users             users?          @relation(fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "FK__groups__created___173876EA")
  posts             posts[]
}

model posts {
  post_id    Int         @id(map: "PK__posts__3ED787665E7D32AB") @default(autoincrement())
  content    String      @db.NVarChar(Max)
  user_id    Int?
  group_id   Int?
  image       String?     @db.NVarChar(Max)
  created_at DateTime?   @default(now(), map: "DF__posts__created_a__1ED998B2") @db.DateTime
  comments   comments[]
  groups     groups?     @relation(fields: [group_id], references: [group_id], onDelete: NoAction, onUpdate: NoAction, map: "FK__posts__group_id__20C1E124")
  users      users?      @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "FK__posts__user_id__1FCDBCEB")
  reactions  reactions[]
}

model reactions {
  reaction_id   Int       @id(map: "PK__reaction__36A9D2980440C72D") @default(autoincrement())
  user_id       Int?
  post_id       Int?
  comment_id    Int?
  reaction_type String?   @db.NVarChar(50)
  created_at    DateTime? @default(now(), map: "DF__reactions__creat__286302EC") @db.DateTime
  comments      comments? @relation(fields: [comment_id], references: [comment_id], onDelete: NoAction, onUpdate: NoAction, map: "FK__reactions__comme__2B3F6F97")
  posts         posts?    @relation(fields: [post_id], references: [post_id], onDelete: NoAction, onUpdate: NoAction, map: "FK__reactions__post___2A4B4B5E")
  users         users?    @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "FK__reactions__user___29572725")
}

model sysdiagrams {
  name         String @db.NVarChar(128)
  principal_id Int
  diagram_id   Int    @id(map: "PK__sysdiagr__C2B05B61E472AA0A") @default(autoincrement())
  version      Int?
  definition   Bytes?

  @@unique([principal_id, name], map: "UK_principal_name")
}

model users {
  user_id       Int             @id(map: "PK__users__B9BE370F4ADB77BF") @default(autoincrement())
  email         String          @unique(map: "UQ__users__AB6E6164ECD4F32E") @db.NVarChar(255)
  full_name     String          @db.NVarChar(255)
  username      String          @unique @db.NVarChar(255)
  password      String
  image         String?         @db.NVarChar(Max)
  role          String?         @db.NVarChar(10)
  gender        String?         @db.NVarChar(10)
  created_at    DateTime?       @default(now(), map: "DF__users__created_a__117F9D94") @db.DateTime
  comments      comments[]
  group_members group_members[]
  groups        groups[]
  posts         posts[]
  reactions     reactions[]
}
